# Albert .gitignore

############
## IDEs
############

*.pydevproject
.project
.metadata
*.swp
*~.nib
*~
local.properties
.classpath
.settings/
.loadpath
.externalToolBuilders/
*.launch
.cproject
.buildpath
.vscode
.idea/
nbproject/
phpcs.xml
.phpcs.xml
phpunit.xml
phpunit-integration.xml
phpunit-wp.xml
.phpunit.result.cache

############
## OSes
############

[Tt]humbs.db
[Dd]esktop.ini
*.DS_store
.DS_store?
.DS_Store
._*
.Trashes

############
## Composer
############

/vendor/
/lib/mcp-adapter/vendor/

# composer.lock IS committed (this is a deployable plugin, not a library) so
# every environment — dev, CI, release — resolves identical versions.

############
## Node/NPM
############

node_modules/
npm-debug.log
yarn-error.log
yarn.lock
bower_components/

# package-lock.json IS committed (like composer.lock) so dev/CI/release builds
# resolve identical npm versions and `npm ci` works in the release workflow.

############
## Build files
############

/build/
/dist/
/assets/build/
/js/dist/*
/css/dist/*
/artifact/
/artifact.zip
webpack-stats.json

############
## Testing
############

/tests/coverage/
/coverage
/.phpunit.result.cache

############
## Logs
############

*.log
debug.log

############
## Temp files
############

tmp/
temp/
.tmp
*.tmp
*.temp
*.bak
*.[Cc]ache
!.cache
*.cpr
*.orig
*.php.in
.svn
.env

############
## Generated files
############

/src/generated/
dependencies.json
dependencies.md

# Planning docs. Working notes, deliberately not shipped with the plugin.
docs/features/
docs/plans/
docs/references/

# Working artefacts. Design handoffs, UI-verification screenshots, per-agent
# memory and local hooks: useful while building, not part of the plugin and not
# worth ~6MB of binary history. Deliberately not deleted, just untracked.
/cleanup/
/design_handoff_*/
.claude/agent-memory/
.claude/hooks/

# Session discussion notes. The tracked .claude/*-plan.md and *-summary.md docs
# are kept on purpose; these are scratch.
.claude/*-discussion.md
