{
  "permissions": {
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/shared/hooks/check-git-naming.sh\""
          }
        ]
      }
    ]
  }
}
