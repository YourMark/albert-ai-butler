# Distribution ignore - files excluded from production plugin zip

# Hidden / OS files
.DS_Store
.phpunit.result.cache

# Version control
.git/
.gitignore

# Development tooling
.claude
.github
.distignore
.editorconfig
AGENTS.md
agent-rules
.gitmodules

# Dependencies
composer.lock
node_modules/

# Dev config
phpcs.xml.dist
phpstan.neon
phpstan-bootstrap.php
phpunit.xml.dist
phpunit-unit.xml.dist
package.json
package-lock.json
webpack.config.js

# JS/SCSS source — only the compiled assets/build/ output ships
assets/src/

# Dev scripts and tests
# The Claude Desktop bridge's build project; its output in assets/claude-desktop/ ships.
tools/
bin/
scripts/
tests/

# Documentation (dev-only)
CLAUDE.md
DEVELOPER_GUIDE.md
plan.md
README.md
docs/
phpstan-stubs/

# Local working directories, untracked but present in a dev checkout
cleanup/
plans/
design_handoff_*/

# The MCP adapter also ships as a standalone plugin, so the package carries its
# own bootstrap and its own wordpress.org readme. Albert autoloads PSR-4 from
# includes/ and never touches either, so they are dead weight — and a second
# `Plugin Name:` and `Stable tag:` inside our SVN trunk invites a question at
# review for no benefit.
lib/mcp-adapter/vendor/wordpress/mcp-adapter/mcp-adapter.php
lib/mcp-adapter/vendor/wordpress/mcp-adapter/readme.txt

# Non-permitted vendor files
vendor/bin/
vendor/*/bin/
vendor/**/.deployignore
vendor/**/.deepsource.toml
vendor/**/dist/*.asc
vendor/**/dist/*.asc.sig
vendor/**/*.bat
lib/mcp-adapter/vendor/bin/
lib/mcp-adapter/vendor/*/bin/
lib/mcp-adapter/vendor/**/.deployignore
lib/mcp-adapter/vendor/**/.deepsource.toml
lib/mcp-adapter/vendor/**/dist/*.asc
lib/mcp-adapter/vendor/**/dist/*.asc.sig
lib/mcp-adapter/vendor/**/*.bat

# WordPress.org directory assets (screenshots, banners, icons)
.wordpress-org
